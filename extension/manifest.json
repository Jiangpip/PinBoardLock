{
  "manifest_version": 3,
  "name": "PinBoardLock",
  "version": "0.5.0",
  "description": "把 Pinterest 的“保存（Save）”固定到你选的收藏夹（Board）；按 AI 出的调研单一组组搜图、分区保存；一键下载到本地（可选写进 Billfish）。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.co.kr/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PinBoardLock",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.co.kr/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.co.kr/*"
      ],
      "js": [
        "sheet.js",
        "picker.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*",
        "https://chat.qwen.ai/*",
        "https://www.tongyi.com/*",
        "https://www.qianwen.com/*",
        "https://yuanbao.tencent.com/*",
        "https://grok.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "sheet.js",
        "capture.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
